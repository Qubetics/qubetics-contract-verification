{
   "openapi": "3.0.2",
   "info": {
      "title": "Evm Apis",
      "description": "Evm service",
      "version": "1.0.0"
   },
   "produces": ["application/json"],
   "servers": [
      {
         "url": "http://localhost:6000",
         "description": "Development server"
      } 
   ],
   "components": {
      "schemas":{
         "Contracts": {
            "type": "object",
            "properties": {
               "contractAddress": {
                  "type": "string"
               },
               "blockHash": {
                  "type": "string"
               },
               "bytecode": {
                  "type": "string"
               },
               "blockNumber": {
                  "type": "number"
               },
               "txhash" : {
                  "type": "string"
               },
               "contractName": {
                  "type": "string"
               },
               "contractType": {
                  "type": "enum"
               },
               "blockTimestamp" : {
                  "type": "int"
               },
               "createdAt": {
                  "type": "string"
               },
               "updatedAt": {
                  "type": "string"
               }
            }
         },
         "ContractVerification": {
            "type": "object",
            "properties": {
               "contractAddress": {
                  "type": "string"
               },
               "sourceCode": {
                  "type": "json"
               },
               "codeformat": {
                  "type": "string"
               },
               "contractname": {
                  "type": "string"
               },
               "compilerversion" : {
                  "type": "string"
               },
               "evmVersion "      : {
                  "type": "string"
               },
               "optimizationUsed": {
                  "type": "boolean"
               },
               "verificationType" : {
                  "type": "int"
               },
               "runs":{
                  "type": "int"
               },
               "licenseType": {
                  "type": "int"
               },
               "abi": {
                  "type": "json"
               },
               "errors": {
                  "type": "json"
               },
               "createdAt": {
                  "type": "string"
               },
               "updatedAt": {
                  "type": "string"
               }
            }
         }
      }
   },
   "paths": {
      "/evm/contracts/verify": {
         "post": {
            "tags": ["EVM"],
            "summary": "Verify contarct",
            "requestBody": {
               "description": "",
               "content": {
                  "application/json": {
                     "schema": {
                        "type": "object",
                        "properties": {
                           "contractaddress": {
                              "type": "string"
                           },
                           "codeformat": {
                              "type": "string"
                           },
                           "compilerversion": {
                              "type": "string"
                           },
                           "files": {
                              "type": "string"
                           },
                           "sourceCode": {
                              "type": "string"
                           },
                           "licenseType": {
                              "type": "number"
                           }
                        },
                        "example": {
                           "contractaddress": "abgy6234o",
                           "codeformat": "solidity-single-file",
                           "compilerversion":"v0.8.24+commit.e11b9ed9",
                           "sourceCode":"abc",
                           "licenseType":1
                        }
                     }
                  }
               }
            },
            "responses": {
               "200": {
                  "description": "Contract verification under process, please check after some time.",
                  "content": {
                     "application/json": {
                        "schema": {
                           "type": "object",
                           "properties": {
                              "message": {
                                 "type": "string"
                              }
                           }
                        }
                     }
                  }
               },
               "400": {
                  "description": "Oops! Something went wrong. Please try again."
               }
            }
         }
      },
