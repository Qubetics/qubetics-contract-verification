{
  "name": "evm-contract-verification",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "types": "./types/global.d.ts",
  "scripts": {
    "start": "nodemon index.js",
    "build": "npm run lint && tsc -p . && cp .env ./build/.env",
    "build:test": "npm run lint && tsc -p . && cp .env ./build/.env && cp .env.test ./build/.env.test",
    "build:prod": "tsc -p .",
    "build:stag": "npm run lint && tsc -p . && cp .env ./build/.env && cp .env.stag ./build/.env.stag",
    "start:local": "npm run lint && NODE_ENV=local nodemon index.js",
    "start:test": "NODE_ENV=test node build/src/server.js",
    "start:staging": "NODE_ENV=staging node build/src/server.js",
    "start:production": "NODE_ENV=production node build/src/server.js",
    "lint": "eslint src/**/*.ts",
    "lint-fix": "eslint --fix src/**/*.ts",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install",
    "precommit": "npm run lint-fix && npm run pretty && git add .",
    "prepush": "npm run lint ",
    "test:custom": "npm test --  tests/unit-tests/environments/environment.spec.ts",
    "generate": "npm -s run generate:prisma && npm -s run generate:nexus",
    "generate:prisma": "prisma generate",
    "generate:nexus": "ts-node --transpile-only src/schema",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@prisma/extension-read-replicas": "^0.2.2",
    "@types/morgan": "^1.9.9",
    "amqplib": "^0.10.3",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "cron": "^4.3.3",
    "dotenv": "^16.3.1",
    "ethers": "^6.13.2",
    "evm": "^0.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "joi": "^17.10.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.9",
    "prisma-redis-middleware": "^4.8.0",
    "redis": "^4.6.10",
    "solc": "^0.8.25",
    "typescript": "^5.1.6",
    "web3": "^4.6.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.23",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.45.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "supertest": "^6.3.4",
    "swagger-ui-express": "^5.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.1"
  }
}
