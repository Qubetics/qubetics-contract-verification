model ContractVerification {
  id                      Int          @id @default(autoincrement())  
  contractAddress         String       @unique
  implementation          String       @default("")
  sourceCode              Json         @default("[]")
  codeformat              String
  contractname            String       @default("")
  compilerversion         String
  evmVersion              String       @default("")
  optimizationUsed        Boolean      @default(false)
  verificationType        Int          @default(0) //0:pending,1:partial,2:fully ,-1:rejected
  runs                    Int          @default(200)
  licenseType             Int          @default(0)
  constructorArguements   Json         @default("[]")
  creationCode            String       @default("")
  byteCode                String       @default("")
  abi                     Json         @default("[]")
  abis                    Json         @default("[]")
  errors                  Json         @default("[]")
  iconUrl                 String       @default("")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}


